# Спільні правила для всього репозиторію — діють і на наявні гілки `lesson-N`,
# і на всі майбутні. Локальні `.gitignore` всередині папок завдань лише
# доповнюють цей файл.

# =============================================================================
# Terraform
# =============================================================================
# Локальний кеш: бінарники провайдерів і копії модулів. Важить сотні мегабайтів,
# залежить від ОС та архітектури і повністю відновлюється через `terraform init`.
**/.terraform/

# Стейт — найнебезпечніше з усього списку: значення в ньому зберігаються
# у відкритому вигляді, включно з паролями й ключами.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Плани можуть містити ті самі чутливі значення.
*.tfplan
*.tfplan.*

# Файли зі змінними (приклади лишаємо).
*.tfvars
*.tfvars.json
!*.tfvars.example

# Локальні override-файли та crash-логи.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log

# =============================================================================
# Kubernetes / Helm
# =============================================================================
# Завантажені залежності чартів і зібрані пакети.
**/charts/*/charts/
*.tgz

# Kubeconfig містить токени доступу до кластера.
kubeconfig
kubeconfig.*
.kube/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
db.sqlite3
db.sqlite3-journal

# =============================================================================
# Секрети та локальні змінні середовища
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials
.aws/

# =============================================================================
# Архіви для здачі
# =============================================================================
*.zip
*.tar.gz

# =============================================================================
# IDE та ОС
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
